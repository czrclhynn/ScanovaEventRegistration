# Existing Supabase PostgreSQL settings. Keep real values in .env.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=

# Supply the public certificate from Supabase Connect / Database Settings.
# Use either a file path or a PEM (literal \n sequences are supported).
SUPABASE_CA_FILE=
SUPABASE_CA_CERT=

# Server-only runtime and Supabase Auth configuration.
APP_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SCANOVA_TICKET_KEY=

# n8n production webhook and matching header credential.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
