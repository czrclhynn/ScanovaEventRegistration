      "id": "ad0dbb71-afac-46b9-8c41-000000000005",
      "name": "Obtain QR Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        200
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const info = $('Retrieve Ticket Information').first().json;\nconst escape = value => String(value).replace(/[&<>\"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '\"':'&quot;', \"'\":'&#39;' }[c]));\nconst date = new Intl.DateTimeFormat('en-PH', { dateStyle: 'full', timeZone: 'Asia/Manila' }).format(new Date(info.date + 'T00:00:00+08:00'));\nconst formatTime = time => new Intl.DateTimeFormat('en-PH', { timeStyle: 'short', timeZone: 'Asia/Manila' }).format(new Date(info.date + 'T' + time.slice(0, 5) + ':00+08:00'));\nconst time = formatTime(info.start) + ' – ' + formatTime(info.end);\nconst image = (await this.helpers.getBinaryDataBuffer(0, 'ticket')).toString('base64');\nconst fact = (label, value) => '<tr><td width=\"72\" valign=\"top\" style=\"padding:6px 12px 6px 0;font-size:12px;font-weight:bold;color:#52647c;\">' + label + '</td><td style=\"padding:6px 0;font-size:15px;line-height:1.5;color:#182238;overflow-wrap:anywhere;\">' + escape(value) + '</td></tr>';\nconst html = [\n  '<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Scanova QR ticket</title></head>',\n  '<body style=\"margin:0;padding:0;background:#edf1f8;color:#182238;font-family:Arial,Helvetica,sans-serif;\">',\n  '<div style=\"display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all;\">Your seat is confirmed. Your check-in QR code is inside.</div>',\n  '<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#edf1f8\"><tr><td align=\"center\" style=\"padding:24px 12px;\">',\n  '<!--[if mso]><table role=\"presentation\" width=\"560\"><tr><td><![endif]-->',\n  '<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"max-width:560px;\">',\n  '<tr><td bgcolor=\"#10182d\" style=\"padding:28px 26px;color:#ffffff;border-radius:16px 16px 0 0;border-top:4px solid #f07870;\">',\n  '<p style=\"margin:0 0 15px;font-size:13px;font-weight:bold;letter-spacing:2.5px;color:#ffb0a8;\">SCANOVA</p>',\n  '<h1 style=\"margin:0;font-size:30px;line-height:1.18;color:#ffffff;\">Your seat is confirmed</h1></td></tr>',\n  '<tr><td bgcolor=\"#ffffff\" style=\"padding:24px 26px;color:#182238;\">',\n  '<p style=\"margin:0 0 10px;font-size:15px;line-height:1.5;\">Hi ' + escape(info.name) + ',</p>',\n  '<p style=\"margin:0 0 16px;font-size:15px;line-height:1.5;\">You’re registered for <strong>' + escape(info.event_name) + '</strong>.</p>',\n  '<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"border-top:1px solid #dde5f0;\">',\n  fact('DATE', date), fact('TIME', time), fact('VENUE', info.venue), '</table></td></tr>',\n  '<tr><td align=\"center\" bgcolor=\"#f6f8fc\" style=\"padding:24px 18px;border-top:1px dashed #c3cde0;border-radius:0 0 16px 16px;\">',\n  '<h2 style=\"margin:0 0 12px;font-size:19px;color:#182238;\">Your check-in QR</h2>',\n  '<img src=\"cid:scanova-ticket\" width=\"224\" height=\"224\" alt=\"Your Scanova check-in QR code\" style=\"display:block;width:224px;max-width:100%;height:auto;margin:0 auto;background:#ffffff;border:1px solid #d6deec;border-radius:10px;\">',\n  '<p style=\"margin:14px 0 0;max-width:300px;font-size:14px;line-height:1.5;color:#465773;\">Show this code at the entrance. You can use your phone or print the attached ticket.</p>',\n  '</td></tr><tr><td align=\"center\" style=\"padding:18px 10px 0;font-size:12px;color:#52647c;\">Scanova · Event registration</td></tr></table>',\n  '<!--[if mso]></td></tr></table><![endif]--></td></tr></table></body></html>',\n].join('');\nreturn [{ json: {\n  from: 'Scanova <tickets@scanova.example.com>',\n  to: [info.recipient],\n  subject: 'Your Scanova ticket for ' + info.event_name.replace(/[\\r\\n]+/g, ' '),\n  html,\n  text: ['Hi ' + info.name + ',', 'Your seat for ' + info.event_name + ' is confirmed.', date, time, info.venue, 'Show the attached QR code at the event entrance.'].join('\\n'),\n  attachments: [{ filename: 'scanova-ticket.png', content: image, content_type: 'image/png', content_id: 'scanova-ticket' }],\n} }];"
      },
