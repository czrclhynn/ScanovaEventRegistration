    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst status = Number(response.statusCode);\nconst reference = response.body?.id;\nif (status >= 200 && status < 300 && typeof reference === 'string' && reference) {\n  return [{ json: { outcome: 'sent', providerReference: reference } }];\n}\nconst definitive = [400,401,403,404,422].includes(status);\nreturn [{ json: { outcome: definitive ? 'rejected' : 'retry' } }];"
