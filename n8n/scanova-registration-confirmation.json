        0,
        200
      ],
      "webhookId": "38382fbe-2e64-4abe-968c-beafafd1e6a8"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nif (!body || typeof body !== 'object' || Array.isArray(body) ||\n    Object.keys(body).length !== 1 || typeof body.deliveryId !== 'string' ||\n    !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(body.deliveryId)) {\n  return [{ json: { valid: false } }];\n}\nreturn [{ json: { valid: true, deliveryId: body.deliveryId } }];"
      },
      "id": "ad0dbb71-afac-46b9-8c41-000000000002",
      "name": "Validate Webhook Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
