        "method": "GET",
        "url": "={{ 'https://scanova.example.com/api/scanova/automation/qr?deliveryId=' + $('Validate Webhook Payload').first().json.deliveryId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
